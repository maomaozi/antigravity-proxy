{
  "visibility": {
    "showPatterns": ["image"],
    "hidePatterns": ["^gemini-(?:[0-2](?:\\.|-|$)|3(?:\\.[0-5](?:-|$)|-(?![0-9])|$))"]
  },
  "poolRules": [
    {
      "patterns": ["^gemini-4-argon(?:-|$)", "^gemini-pro-orchestrator-g1-pro$", "orchestrator.*argon"],
      "pools": ["Gemini 4 Argon", "Gemini Models"]
    },
    {
      "patterns": ["claude", "gpt"],
      "pools": ["Claude and GPT models"]
    },
    {
      "patterns": ["^gemini-4-hydrogen(?:-|$)"],
      "pools": ["Gemini Models"]
    },
    {
      "patterns": ["gemini"],
      "pools": ["Gemini Models"],
      "preferDeclaredPool": true
    }
  ],
  "groups": [
    {
      "name": "Gemini 4 Hydrogen",
      "patterns": ["^gemini-4-hydrogen(?:-|$)"],
      "separateWhen": "different-accounts"
    },
    {
      "name": "Claude 4.6",
      "patterns": ["^claude-(?:sonnet|opus)-4[.-]6(?:-|$)"],
      "separateWhen": "different-accounts"
    },
    {
      "name": "Claude 5.5",
      "patterns": ["^claude-(?:sonnet|opus)-5[.-]5(?:-|$)"],
      "separateWhen": "different-accounts"
    },
    {
      "name": "GPT-OSS 120B",
      "patterns": ["^gpt-oss-120b(?:-|$)"],
      "separateWhen": "always"
    }
  ],
  "groupOrder": ["Gemini Models", "Gemini 4 Hydrogen", "Claude 4.6", "Claude 5.5", "GPT-OSS 120B", "Claude and GPT models", "Gemini 4 Argon"]
}
